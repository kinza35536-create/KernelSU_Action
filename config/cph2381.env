CONFIG_ENV=config/cph2381.env

KERNEL_SOURCE=https://github.com/oscaro-resources/android_kernel_oneplus_sm6375
KERNEL_SOURCE_BRANCH=16.2

KERNEL_CONFIG=vendor/holi-qgki_defconfig
KERNEL_IMAGE_NAME=Image

ARCH=arm64

KSU_VARIANT=kernelsu-next
KSU_REF=legacy
KSU_HOOK_MODE=kprobes

ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false

DISABLE_LTO=false
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

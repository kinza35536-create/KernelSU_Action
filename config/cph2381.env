# ============================================================
# KernelSU Action - OnePlus CPH2381 / SM6375
# ============================================================

CONFIG_ENV=config/cph2381.env

# ============================================================
# Kernel Source
# ============================================================

KERNEL_SOURCE=https://github.com/oscaro-resources/android_kernel_oneplus_sm6375
KERNEL_SOURCE_BRANCH=16.2

KERNEL_CONFIG=vendor/holi-qgki_defconfig
KERNEL_IMAGE_NAME=Image

ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# ============================================================
# Build Commands
# ============================================================

EXTRA_CMDS=
CUSTOM_CMDS=

# ============================================================
# Clang
# ============================================================

CLANG_BRANCH=main-kernel
CLANG_VERSION=r522817

USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://gitlab.com/kei-space/clang/r522817.git
CUSTOM_CLANG_BRANCH=master

USE_LLVM=true

# ============================================================
# GCC
# ============================================================

ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ============================================================
# KernelSU
# ============================================================

KSU_VARIANT=kernelsu
KSU_REF=v0.9.5

# 5.4 kernel -> manual hooks
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ============================================================
# SUSFS
# ============================================================

ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ============================================================
# KernelSU Features
# ============================================================

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ============================================================
# Kconfig
# ============================================================

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false

DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=CONFIG_SECTION_MISMATCH_WARN_ONLY=y CONFIG_KPROBES=n CONFIG_KPROBE_EVENTS=n

# ============================================================
# AnyKernel3
# ============================================================

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================
# DTBO / Boot Image
# ============================================================

NEED_DTBO=false

BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ============================================================
# Runner
# ============================================================

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
